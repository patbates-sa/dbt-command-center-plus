# dbt Command Center Configuration
# ===================================
# See /setup page for step-by-step connection instructions.

# dbt Cloud API Configuration (required)
DBT_CLOUD_API_TOKEN=your_service_token_here
DBT_CLOUD_BASE_URL=https://cloud.getdbt.com
DBT_CLOUD_ACCOUNT_ID=12345

# Discovery API (GraphQL)
DBT_DISCOVERY_API_URL=https://metadata.cloud.getdbt.com/graphql

# Semantic Layer API (optional — app degrades gracefully if unavailable)
DBT_SEMANTIC_LAYER_URL=https://semantic-layer.cloud.getdbt.com/api/graphql
DBT_SEMANTIC_LAYER_TOKEN=

# Default project and environment IDs
DBT_DEFAULT_PROJECT_ID=
DBT_DEFAULT_ENVIRONMENT_ID=

# Webhook secret (optional — for real-time job status updates)
DBT_WEBHOOK_SECRET=

# Jira MCP Integration (optional — powers the /jira-tickets page)
# The Next.js server spawns an MCP server as a child process over stdio.
# Default below uses the community sooperset/mcp-atlassian server via uvx.
JIRA_MCP_COMMAND=uvx
JIRA_MCP_ARGS=mcp-atlassian
JIRA_URL=https://your-org.atlassian.net
# Same URL exposed to the browser for deep links (e.g. "Create" button)
NEXT_PUBLIC_JIRA_URL=https://your-org.atlassian.net
# Preselect these in the Create dialog (project key or numeric ID; issue type name or ID)
# NEXT_PUBLIC_JIRA_DEFAULT_PROJECT=KAN
# NEXT_PUBLIC_JIRA_DEFAULT_TYPE=Task
JIRA_USERNAME=you@example.com
JIRA_API_TOKEN=
# JIRA_PERSONAL_TOKEN=   # use this instead of API token for self-hosted Server/DC
# JIRA_MCP_TOOL_NAME=jira_search  # override if your MCP server exposes a different tool
JIRA_DEFAULT_JQL=assignee = currentUser() ORDER BY updated DESC

# Root directory containing your local dbt project clones (used by the Execute button)
DBT_PROJECT_ROOT=/Users/you/dbt

# Editor command to launch on Execute (must be on PATH).
# Defaults to "code" (VS Code stable). Set to "code-insiders" or "cursor" to override.
# EXECUTE_EDITOR_COMMAND=code

# Logging
LOG_LEVEL=info
